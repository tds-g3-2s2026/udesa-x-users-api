# EditorConfig - https://editorconfig.org
# Este archivo se sincroniza desde udesa-x-platform hacia todos los repos.
# No editar la copia local: editar la fuente en udesa-x-platform y sincronizar.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[*.{tf,tfvars}]
indent_size = 2
