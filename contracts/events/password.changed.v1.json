{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udesa-x:eventos:password.changed.v1",
  "title": "password.changed.v1",
  "description": "La contraseña de una cuenta cambió y se cerraron sus sesiones. Lo publica users-api; notifications-api manda el aviso por email.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "description": "Identificador único del evento. El consumidor lo usa para descartar repetidos.",
      "type": "string",
      "format": "uuid"
    },
    "source": { "const": "users-api" },
    "type": { "const": "password.changed.v1" },
    "time": {
      "description": "Instante en que cambió la contraseña.",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["user_id", "email"],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "description": "Dirección normalizada a minúsculas, a la que va el aviso.",
          "type": "string",
          "format": "email"
        }
      }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "0199f3c3-6d7e-7f80-a192-0b1c2d3e4f56",
      "source": "users-api",
      "type": "password.changed.v1",
      "time": "2026-10-24T10:20:45Z",
      "data": {
        "user_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "email": "alumno@udesa.edu.ar"
      }
    }
  ]
}
