{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udesa-x:eventos:feedback.submitted.v1",
  "title": "feedback.submitted.v1",
  "description": "Un usuario envió un comentario o reportó un error desde la app. Lo publica users-api; notifications-api lo manda por email a la cuenta de soporte.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "description": "Identificador único del evento. El consumidor lo usa para descartar repetidos.",
      "type": "string",
      "format": "uuid"
    },
    "source": { "const": "users-api" },
    "type": { "const": "feedback.submitted.v1" },
    "time": {
      "description": "Instante en que se envió el mensaje.",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["feedback_id", "user_id", "handle", "message", "device_os", "app_version"],
      "additionalProperties": false,
      "properties": {
        "feedback_id": {
          "description": "Identificador del registro en users-api.",
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "handle": {
          "description": "Handle de la cuenta al momento de enviar.",
          "type": "string"
        },
        "message": {
          "description": "Texto libre que escribió el usuario. Es contenido no confiable: se muestra como texto, nunca como HTML.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "device_os": {
          "description": "Sistema operativo del dispositivo, como lo informa la app.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "app_version": {
          "description": "Versión de la app, como la informa la app.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "0199f3d4-7e8f-7a91-b2a3-1c2d3e4f5a67",
      "source": "users-api",
      "type": "feedback.submitted.v1",
      "time": "2026-11-05T14:30:00Z",
      "data": {
        "feedback_id": "3f6c1e2a-9b7d-4c58-a1e0-6d2f8b4c7a19",
        "user_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "handle": "@alumno_01",
        "message": "La pantalla de perfil se queda cargando cuando no hay conexión.",
        "device_os": "Android 15",
        "app_version": "1.3.0"
      }
    }
  ]
}
