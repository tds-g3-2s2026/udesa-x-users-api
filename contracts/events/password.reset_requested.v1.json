{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udesa-x:eventos:password.reset_requested.v1",
  "title": "password.reset_requested.v1",
  "description": "Se pidió recuperar la contraseña de una cuenta que existe. Lo publica users-api; notifications-api manda el email con el código.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "description": "Identificador único del evento. El consumidor lo usa para descartar repetidos.",
      "type": "string",
      "format": "uuid"
    },
    "source": { "const": "users-api" },
    "type": { "const": "password.reset_requested.v1" },
    "time": {
      "description": "Instante en que se emitió el código.",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["user_id", "email", "token"],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "description": "Dirección normalizada a minúsculas, a la que va el código.",
          "type": "string",
          "format": "email"
        },
        "token": {
          "description": "Código de un solo uso que el usuario pega en la app. Da acceso a la cuenta hasta que vence: no se loguea.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "0199f3c2-4b5c-7d6e-9f70-8a9b0c1d2e34",
      "source": "users-api",
      "type": "password.reset_requested.v1",
      "time": "2026-10-24T10:15:02Z",
      "data": {
        "user_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "email": "alumno@udesa.edu.ar",
        "token": "Xc5vB8nM2kLj6hGf"
      }
    }
  ]
}
