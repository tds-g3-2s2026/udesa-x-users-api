{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udesa-x:eventos:email_verification.requested.v1",
  "title": "email_verification.requested.v1",
  "description": "Una cuenta sin validar pidió un link de verificación nuevo. Lo publica users-api; notifications-api manda el email. El link del registro viaja en user.registered.v1.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "description": "Identificador único del evento. El consumidor lo usa para descartar repetidos.",
      "type": "string",
      "format": "uuid"
    },
    "source": { "const": "users-api" },
    "type": { "const": "email_verification.requested.v1" },
    "time": {
      "description": "Instante en que se emitió el link nuevo.",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["user_id", "email", "verification_url"],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "description": "Dirección normalizada a minúsculas, a la que va el link.",
          "type": "string",
          "format": "email"
        },
        "verification_url": {
          "description": "Link completo de verificación, con el token de un solo uso. Es un secreto hasta que vence: no se loguea.",
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "0199f3c1-2a3b-7c4d-8e5f-6a7b8c9d0e12",
      "source": "users-api",
      "type": "email_verification.requested.v1",
      "time": "2026-10-24T10:12:30Z",
      "data": {
        "user_id": "7a1d3c9b-2e4f-4a6b-8d0c-1f3e5a7b9c2d",
        "email": "alumno@udesa.edu.ar",
        "verification_url": "https://udesa-x.example/api/auth/verify?token=Qw7eR4tY1uIo3pAs"
      }
    }
  ]
}
